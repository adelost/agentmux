# Required only for the Discord bridge. The local CLI works without it.
DISCORD_TOKEN=

# Optional — all have sane defaults

# Tmux socket path (default: /tmp/agentmux-tmux.sock)
# TMUX_SOCKET=/tmp/agentmux-tmux.sock

# Path to agentmux.yaml config (default: ~/.agentmux/agentmux.yaml)
# AGENTMUX_YAML=/path/to/agentmux.yaml

# Path to generated agents.yaml (default: ./agents.yaml)
# AGENTS_YAML=/path/to/agents.yaml

# Max wait for agent response in seconds (default: 600)
# TIMEOUT_S=600

# Text-to-speech voice (default: en-US-AriaNeural)
# TTS_VOICE=en-US-AriaNeural

# Human-facing operator label (default: "the operator")
# AMUX_OPERATOR_NAME=Ada

# Optional Suggestions-compatible board. Unset means disabled; AMUX never
# contacts the project author's private service by default.
# SUGGEST_BASE_URL=https://tasks.example.com

# Optional compatibility with an existing OpenClaw workspace.
# OPENCLAW_WORKSPACE=~/.openclaw/workspace
# AMUX_TODOS_PATH=~/.openclaw/workspace/memory/tasks.md

# Enable TTS on startup (default: 0)
# TTS=0

# Mobile user notifications (Discord DM preferred, #notify fallback)
# If unset, agentmux tries ~/.openclaw/credentials/discord-allowFrom.json
# AMUX_NOTIFY_USER_ID=123456789012345678
# AMUX_NOTIFY_CHANNEL=notify

# OpenAI API key (for Whisper transcription of voice messages)
# OPENAI_API_KEY=
