# Start with an empty fleet, then run:
#   amux add myproject ~/projects/myproject
# The command detects Claude Code, Codex, or Kimi Code instead of assuming
# one vendor is installed.
agents: {}

# Optional Discord integration. Uncomment after adding DISCORD_TOKEN.
# guild: "YOUR_SERVER_ID"
# category: "Agent Cave"

# Optional manual examples:
# agents:
#   api:
#     dir: ~/projects/api
#     claude: 2
#     codex: 1
#     shells: 2
#   frontend:
#     dir: ~/projects/frontend
#     kimi: 1
#     services:
#       - npm run dev
