{
  "name": "@agentmux/link-product",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "generate": "npm run build && node dist/src/generate.js",
    "check-generated": "npm run build && node dist/src/generate.js --check",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@v1d/circlekit-assets": "https://circlekit.pages.dev/npm/v1d/circlekit-assets/0.3.54/v1d-circlekit-assets-0.3.54.tgz",
    "@v1d/product-emit": "https://circlekit.pages.dev/npm/v1d/product-emit/0.1.16/v1d-product-emit-0.1.16.tgz",
    "@v1d/product-spec": "https://circlekit.pages.dev/npm/v1d/product-spec/0.3.52/v1d-product-spec-0.3.52.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  }
}
